# ─────────────────────────────────────────────────────────────────────────────
# WILD MUSE — environment variables. Copy to `.env` and fill in.
# NEVER commit real values. Variables starting NEXT_PUBLIC_ are visible in the browser —
# never put secrets in them.
# ─────────────────────────────────────────────────────────────────────────────

# PostgreSQL (local, or Supabase → Project Settings → Database → connection string)
DATABASE_URL="postgresql://wildmuse:wildmuse_dev@localhost:5432/wildmuse?schema=public"

# Public site URL (no trailing slash). Used for links in emails, sitemap and auth.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Authentication (Better Auth)
# Generate with:  openssl rand -base64 32
BETTER_AUTH_SECRET=""
BETTER_AUTH_URL="http://localhost:3000"
# Optional: check new passwords against known breaches (k-anonymity API). Recommended in production.
AUTH_CHECK_BREACHED_PASSWORDS="false"

# File storage: "local" (./storage, dev/single server) or "supabase"
STORAGE_DRIVER="local"
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""            # server only — never expose
SUPABASE_PUBLIC_BUCKET="media"
SUPABASE_PRIVATE_BUCKET="private"

# Email: "console" (prints to server log) or "resend"
EMAIL_DRIVER="console"
RESEND_API_KEY=""
EMAIL_FROM="Wild Muse <hello@yourdomain.co.uk>"

# Payments — Stripe (Dashboard → Developers → API keys / Webhooks). Use sk_test_ keys until launch.
STRIPE_SECRET_KEY=""
# Signing secret of the webhook endpoint https://<your-domain>/api/webhooks/stripe (whsec_...)
STRIPE_WEBHOOK_SECRET=""

# Royal Mail Click & Drop (optional): Click & Drop → Settings → Integrations → Click & Drop API
ROYALMAIL_CLICKDROP_API_KEY=""

# Scheduled job that releases stock from abandoned checkouts (Vercel Cron sends this as a Bearer token)
CRON_SECRET=""

# Analytics / marketing pixels — only loaded after the visitor consents
NEXT_PUBLIC_GA4_ID=""
NEXT_PUBLIC_META_PIXEL_ID=""
NEXT_PUBLIC_TIKTOK_PIXEL_ID=""
